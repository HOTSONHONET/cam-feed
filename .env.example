INFERENCE_DEVICE=gpu
MODEL_SCORE_THRESHOLD=0.25

# Run object detection at most once per source in this interval.
DETECTION_INTERVAL=500ms

# Alert only for these comma-separated labels.
ALERT_LABELS=person
ALERT_MIN_SCORE=0.65
ALERT_COOLDOWN=30s

SNAPSHOT_DIR=/app/snapshots

# Optional. Leave empty to disable Slack notifications.
SLACK_WEBHOOK_URL=

ORT_CPU_LIB=/app/third_party/onnxruntime/1.24.2/onnxruntime_cpu.so
ORT_GPU_LIB=/app/third_party/onnxruntime/1.24.2/onnxruntime_gpu.so
ORT_GPU_LIB_DIR=/app/third_party/onnxruntime/1.24.2/gpu_libs
