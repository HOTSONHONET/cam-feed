INFERENCE_DEVICE=gpu
MODEL_SCORE_THRESHOLD=0.25

# Run object detection at most once per source in this interval.
DETECTION_INTERVAL=500ms

# Alert only for these comma-separated labels.
ALERT_LABELS=person
ALERT_MIN_SCORE=0.65
ALERT_COOLDOWN=30s

SNAPSHOT_DIR=/app/snapshots

# Slack alert configuration is below.

ORT_CPU_LIB=/app/third_party/onnxruntime/1.24.2/onnxruntime_cpu.so
ORT_GPU_LIB=/app/third_party/onnxruntime/1.24.2/onnxruntime_gpu.so
ORT_GPU_LIB_DIR=/app/third_party/onnxruntime/1.24.2/gpu_libs

# Local host camera. When enabled, the server reads the host webcam directly
# and publishes it to the same hub + surveillance pipeline as remote devices.
LOCAL_CAMERA_ENABLED=false
LOCAL_CAMERA_DEVICE=/dev/video0
LOCAL_CAMERA_DEVICE_ID=fly-high-legion
LOCAL_CAMERA_ROOM=home
LOCAL_CAMERA_WIDTH=1280
LOCAL_CAMERA_HEIGHT=720
LOCAL_CAMERA_INPUT_FPS=10
LOCAL_CAMERA_OUTPUT_FPS=2
LOCAL_CAMERA_JPEG_QUALITY=5

# Incoming webhook is optional fallback text-only notification.
SLACK_WEBHOOK_URL=

# To upload the actual snapshot image to Slack, configure a bot token with
# files:write permission and the destination channel ID.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
